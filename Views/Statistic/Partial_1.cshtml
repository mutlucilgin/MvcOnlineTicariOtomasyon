@model IEnumerable<MvcOnlineTicariOtomasyon.Models.Siniflar.ClassGroup>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Departman Personel Sayısı</h3>
    </div>
    <!-- /.card-header -->
    <div class="card-body p-0">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Departman</th>
                    <th>Progress Bar</th>
                    <th style="width: 100px">Kişi Sayısı</th>
                </tr>
            </thead>
            <tbody>
            <tbody>
                @{ int index = 1; }
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@index </td>
                        <td>@x.Name</td>
                        <td style="vertical-align:middle">
                            @if (x.Count == 1)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar bg-warning" style="width: 55%"></div>
                                </div>
                            }
                            @if (x.Count == 2)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar bg-primary" style="width: 55%"></div>
                                </div>
                            }
                            @if (x.Count >= 3)
                            {
                                <div class="progress progress-xs">
                                    <div class="progress-bar bg-success" style="width: 55%"></div>
                                </div>
                            }
                        </td>
                        <td>
                            @if (x.Count == 1)
                            {
                                <span class="badge bg-warning">@x.Count</span>
                            }
                            @if (x.Count == 2)
                            {
                                <span class="badge bg-primary">@x.Count</span>
                            }
                            @if (x.Count >= 3)
                            {
                                <span class="badge bg-success">@x.Count</span>
                            }
                        </td>
                    </tr>
                    index++;
                }
            </tbody>

            </tbody>
        </table>
    </div>
    <!-- /.card-body -->
</div>
