
<div class="login-form login-form-left">
    <div class="agile-row">
        <h3>Müşteri Girişi</h3>
        <span class="fa fa-lock"></span>
        <div class="clear"></div>
        <div class="login-agileits-top">
            @using (Html.BeginForm("Partial_2", "Login",FormMethod.Post)){
                <input type="text" class="email" name="CustomerMail" Placeholder="Mail Adresiniz" required="" />
                <input type="password" class="password" name="CustomerPassword" Placeholder="Şifreniz" required="" />
                <input type="submit" value="Giriş Yap">
            }
        </div>
        <div class="login-agileits-bottom">
            <h6><a href="#">Şifremi unuttum?</a></h6>
        </div>
    </div>
</div>
