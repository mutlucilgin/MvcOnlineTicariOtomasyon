@*Müşteri kaydı Popup sayfası*@

<div class="login-form login-form-left">
    <div class="agile-row">
        <h3>Yeni Müşteri Kaydı</h3>
        <div class="login-agileits-top">
            <form action="#" method="post">
                <input type="text" class="name" name="CustomerName" Placeholder="Adınız" required="" />
                <input type="text" class="name" name="CustomerSurname" Placeholder="Soyadınız" required="" />
                <input type="text" class="name" name="CustomerCity" Placeholder="Şehir" required="" />
                <input type="email" class="email" name="CustomerMail" Placeholder="Mail Adresiniz" required="" />
                <input type="password" class="password" name="CustomerPassword" Placeholder="Şifreniz" required="" />
                <div class="login-check">
                    <label class="checkbox"><input type="checkbox" name="checkbox" checked=""><i> </i> Kuralları Okudum.<a href="#">&amp; Kabul Ediyorum.</a></label>
                </div>
                <input type="submit" value="Kaydet">
            </form>
        </div>
    </div>
</div>